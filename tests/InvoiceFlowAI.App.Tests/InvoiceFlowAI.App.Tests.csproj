<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>InvoiceFlowAI.App.Tests</RootNamespace>
    <AssemblyName>InvoiceFlowAI.App.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- This project contains more than one Avalonia Application (headless + two
         native WebView end-to-end hosts), so the AtomUI localization bootstrap
         generator cannot pick a single host. The headless host attaches AtomUI
         manually; localization overrides are not used in tests. -->
    <AtomUIDisableLocalizationBuildIntegration>true</AtomUIDisableLocalizationBuildIntegration>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="AtomUI.Desktop.Controls" />
    <PackageReference Include="AtomUI.Icons.AntDesign" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvoiceFlowAI.Domain\InvoiceFlowAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\InvoiceFlowAI.Contracts\InvoiceFlowAI.Contracts.csproj" />
    <ProjectReference Include="..\..\src\InvoiceFlowAI.Application\InvoiceFlowAI.Application.csproj" />
    <ProjectReference Include="..\..\src\InvoiceFlowAI.App\InvoiceFlowAI.App.csproj" />
  </ItemGroup>

</Project>