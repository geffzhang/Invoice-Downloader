<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InvoiceFlowAI.Contracts.Tests</RootNamespace>
    <AssemblyName>InvoiceFlowAI.Contracts.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvoiceFlowAI.Domain\InvoiceFlowAI.Domain.csproj" />
    <ProjectReference Include="..\..\src\InvoiceFlowAI.Contracts\InvoiceFlowAI.Contracts.csproj" />
  </ItemGroup>

  <!-- Golden fixtures are committed in docs/superpowers/fixtures. They are the
       canonical contract for both request/response envelopes and the published
       Recipe/RuleSet/provider/parser/URL registries. The test project links them
       into its output so tests resolve fixtures relative to the assembly without
       copying the source. CI keeps the fixture repo as the single source of truth. -->
  <ItemGroup>
    <None Include="..\..\docs\superpowers\fixtures\**\*.json"
          LinkBase="Fixtures"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>