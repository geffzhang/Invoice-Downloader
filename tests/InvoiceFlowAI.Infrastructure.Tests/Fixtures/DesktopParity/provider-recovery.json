{
  "cases": [
    {
      "caseId": "baiwang-matched-xml-selects-related-pdf-and-rejects-wrapper",
      "selector": "baiwang",
      "expectedFields": { "invoice_number": "12345678901234567890" },
      "captures": [
        { "kind": "Pdf", "sourceUrlOrdinal": 0, "fields": {}, "captureReason": "BAIWANG_WRAPPER_DETECTED" },
        { "kind": "Xml", "sourceUrlOrdinal": 1, "fields": { "invoice_number": "12345678901234567890" }, "captureReason": "CAPTURED" },
        { "kind": "Pdf", "sourceUrlOrdinal": 1, "fields": {}, "captureReason": "CAPTURED" },
        { "kind": "Pdf", "sourceUrlOrdinal": 2, "fields": { "invoice_number": "99999999999999999999" }, "captureReason": "CAPTURED" }
      ],
      "expectedSelectedIndex": 2,
      "expectedSelectedKind": "Pdf",
      "expectedSourceUrlOrdinal": 1,
      "expectedMatchReason": "xml_then_pdf_same_source",
      "expectedWrapperMatch": false
    },
    {
      "caseId": "nuonuo-retries-detail-and-selects-pdf-with-xml-inventory",
      "selector": "nuonuo",
      "providerFamily": "nuonuo_scan_invoice",
      "sourceUrl": "https://nnfp.jss.com.cn/scan-invoice/printqrcode?paramList=fixture-p",
      "expectedFields": {},
      "expectedArtifactKinds": ["Xml", "Pdf"],
      "expectedSelectedIndex": 1,
      "expectedSelectedKind": "Pdf",
      "expectedMatchReason": "ARTIFACT_CAPTURED",
      "responses": [
        { "statusCode": 200, "contentType": "text/html", "body": "" },
        { "statusCode": 200, "contentType": "application/json", "body": "{\"status\":\"1001\"}" },
        { "statusCode": 200, "contentType": "text/html", "body": "" },
        { "statusCode": 200, "contentType": "application/json", "body": "{\"status\":\"0000\",\"data\":{\"invoiceSimpleVo\":{\"xmlUrl\":\"https://files.fixture.invalid/invoice.xml\",\"url\":\"https://files.fixture.invalid/invoice.pdf\"}}}" },
        { "statusCode": 200, "contentType": "application/xml", "body": "<?xml version=\"1.0\"?><invoice/>" },
        { "statusCode": 200, "contentType": "application/pdf", "body": "%PDF-1.7 synthetic" }
      ]
    },
