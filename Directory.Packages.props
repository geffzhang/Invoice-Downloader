<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ZeroPipeline fixed versions per design spec §3 -->
    <PackageVersion Include="ZeroPipeline.Core" Version="1.4.0" />
    <PackageVersion Include="ZeroPipeline.Recipe" Version="1.4.0" />
    <!-- EF Core SQLite -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- IMAP -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- PDF / OCR -->
    <PackageVersion Include="PDFiumCore" Version="157.0.8100" />
    <PackageVersion Include="PdfPig" Version="0.1.17-alpha-202609192350-df33d" />
    <PackageVersion Include="SkiaSharp" Version="4.154.0-preview.1.26454.9" />
    <PackageVersion Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
    <PackageVersion Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <!-- Avalonia UI 12 -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- AtomUI 6.2.8 (LGPL-3.0, shipped as separate DLLs) -->
    <PackageVersion Include="AtomUI.Desktop.Controls" Version="6.2.8" />
    <PackageVersion Include="AtomUI.Icons.AntDesign" Version="6.2.8" />
    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- Reports -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <!-- DI / Hosting / Logging -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- JSON -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <!-- DPAPI -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
  </ItemGroup>
</Project>